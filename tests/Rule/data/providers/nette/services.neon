services:
    - NetteContainerProvider\RegisteredScalar
    named: NetteContainerProvider\RegisteredNamed
    entity: NetteContainerProvider\RegisteredEntity(some-arg)
    viaCreate:
        create: NetteContainerProvider\RegisteredViaCreate
    viaFactory:
        factory: NetteContainerProvider\RegisteredViaFactoryKey
    viaClass:
        class: NetteContainerProvider\RegisteredViaClass
    viaType:
        type: NetteContainerProvider\RegisteredViaType
    child: NetteContainerProvider\RegisteredChild
    productFactory:
        implement: NetteContainerProvider\ProductFactory
    imported:
        type: NetteContainerProvider\ImportedService
        imported: true
    factoryCall: @serviceName::createSomething
    staticFactory: NetteContainerProvider\StaticFactoryService::create()
    viaStaticFactory:
        create: NetteContainerProvider\StaticFactoryViaCreate::create(1)
    withArgument: NetteContainerProvider\RegisteredWithArgument(NetteContainerProvider\InstantiatedArgument())
    importedWithArgument:
        type: NetteContainerProvider\ImportedWithArgument
        arguments: [NetteContainerProvider\NotInstantiatedImportedArgument()]
        imported: true

parameters:
    notEvaluated: NetteContainerProvider\InParameters()

someExtension:
    integrations:
        - NetteContainerProvider\ExtensionStatement(null)
